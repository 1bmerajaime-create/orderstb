rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App interna Tropic Boost. La contraseña de la app filtra el uso normal.
    // Para endurecer: activa Authentication → Anonymous en la consola y cambia a:
    // allow read, write: if request.auth != null;
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
